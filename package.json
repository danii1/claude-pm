{
  "name": "claude-pm",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "claude-pm": "./index.ts"
  },
  "scripts": {
    "build": "bun build index.ts --target=node --outdir=dist --format=esm --external=* && bun run tsc --noEmit",
    "install-global": "bun run build && bun link",
    "uninstall-global": "bun unlink"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/react": "^19.2.7",
    "ink": "^6.6.0",
    "ink-scroll-view": "^0.3.2",
    "react": "^19.2.3"
  }
}
